"""Type information for the native jseries extension module."""

from collections.abc import Sequence
from os import PathLike
from typing import NoReturn, final, overload

__version__: str
__all__ = [
    "DecodeError",
    "DecodedField",
    "DecodedRecord",
    "Decoder",
    "JSeriesError",
    "SchemaError",
    "__version__",
]

class JSeriesError(Exception): ...
class SchemaError(JSeriesError): ...
class DecodeError(JSeriesError): ...

@final
class DecodedField:
    def __new__(cls) -> NoReturn: ...
    @property
    def id(self) -> str: ...
    @property
    def definition_ref(self) -> str: ...
    @property
    def word(self) -> int: ...
    @property
    def lsb(self) -> int: ...
    @property
    def width(self) -> int: ...
    @property
    def raw(self) -> int: ...
    @property
    def status(self) -> str: ...
    @property
    def unsigned_value(self) -> int | None: ...
    @property
    def signed_value(self) -> int | None: ...
    @property
    def numerator(self) -> int | None: ...
    @property
    def denominator(self) -> int | None: ...
    @property
    def unit(self) -> str | None: ...
    @property
    def label(self) -> str | None: ...
    @property
    def selector(self) -> str | None: ...
    @property
    def error(self) -> str | None: ...

@final
class DecodedRecord:
    def __new__(cls) -> NoReturn: ...
    @property
    def package_id(self) -> str: ...
    @property
    def package_version(self) -> str: ...
    @property
    def qualification(self) -> str: ...
    @property
    def source_id(self) -> str: ...
    @property
    def source_offset(self) -> int: ...
    @property
    def message_id(self) -> str: ...
    @property
    def fields(self) -> list[DecodedField]: ...

@final
class Decoder:
    def __new__(cls, schema_path: str | PathLike[str]) -> Decoder: ...
    def message_ids(self) -> list[str]: ...
    @overload
    def decode(
        self,
        message_id: str,
        values: Sequence[int],
        *,
        source_id: str | None = None,
        source_offset: int = 0,
    ) -> DecodedRecord: ...
    @overload
    def decode(
        self,
        message_id: str,
        values: Sequence[Sequence[int]],
        *,
        source_id: str | None = None,
        source_offset: int = 0,
    ) -> list[DecodedRecord]: ...
